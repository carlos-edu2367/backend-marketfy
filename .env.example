ENVIRONMENT=development
DEBUG=true
APP_NAME=SGM Marketfy
API_V1_STR=/api/v1

DATABASE_URL=postgresql://marketfy:marketfy@localhost:5432/marketfy
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory

SECRET_KEY=change-me-dev-secret-with-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=marketfy_refresh
SECURE_COOKIES=false
COOKIE_SAMESITE=lax

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

FISCAL_SECRET_KEY=
METRICS_ACCESS_TOKEN=

# Neectify Fiscal
NEECTIFY_API_KEY=
NEECTIFY_BASE_URL=https://api.neectify.com
NEECTIFY_TIMEOUT_SECONDS=30
NEECTIFY_INTERNAL_CLIENT=marketfy
FISCAL_PROVIDER=neectify_fiscal
FISCAL_WORKER_CONCURRENCY=5
FISCAL_JOB_TIMEOUT=30
FISCAL_STORAGE_ROOT=storage/fiscal
# Leave empty until accountant-approved ICMS groups are available.
FISCAL_APPROVED_ICMS_GROUPS=
FISCAL_OFFLINE_MAX_AGE_MINUTES=30
# Global fiscal-rule rollout kill switch. Keep false until an approved pilot.
FISCAL_PRODUCT_RULES_ENABLED=false

# Fiscal credits
FISCAL_CREDIT_UNIT_PRICE=0.72
FISCAL_CREDIT_MIN_QTY=10
FISCAL_CREDIT_MAX_QTY=10000

# S3-compatible fiscal storage (required by the production deployment)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=marketfy-fiscal
S3_REGION=auto



# Billing Core
BILLING_CORE_ENABLED=false
BILLING_CORE_BASE_URL=http://billing-core:8000
BILLING_CORE_API_KEY=
BILLING_CORE_SYSTEM=marketfy
BILLING_CORE_WEBHOOK_SECRET=
BILLING_CORE_WEBHOOK_CALLBACK_URL=https://marketfy.neectify.local/api/v1/webhooks/billing-core
BILLING_CORE_PAYMENT_DUE_DAYS=3
BILLING_CORE_WEBHOOK_HOST=
BILLING_CORE_TIMEOUT_SECONDS=10

# --- Assinatura: webhook de faturas ---
BILLING_CORE_WEBHOOK_INVOICE_URL=

# --- E-mail (Mailgun) — mesmas credenciais do Neectify Food ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=noreply@neectify.com
MAILGUN_FROM_NAME=Marketfy
MAILGUN_API_BASE_URL=https://api.mailgun.net

# Mercado Pago Pix (QR dinâmico presencial)
MP_ENABLED=false
MP_APP_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/pix/oauth/callback
MP_WEBHOOK_SECRET=
MP_SECRET_KEY=
MP_API_BASE_URL=https://api.mercadopago.com
MP_AUTH_BASE_URL=https://auth.mercadopago.com
MP_ENVIRONMENT=sandbox
MP_ORDER_DEFAULT_EXPIRATION=PT5M
MP_HTTP_TIMEOUT_SECONDS=10
MP_VALIDATE_COOLDOWN_SECONDS=5
PIX_LOCATION_ENABLED=true
